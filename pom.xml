<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>cc.alexlin7</groupId>
    <artifactId>bancho-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>bancho</name>
    <description>bancho monorepo</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>

    <!-- 依賴方向：shell / discord → match → irc；observability 只給前端使用 -->
    <modules>
        <module>bancho-irc</module>
        <module>bancho-match</module>
        <module>bancho-observability</module>
        <module>bancho-shell</module>
        <module>bancho-discord</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- 必須對應 Boot 管理的 OTel API 版本（Boot 4.1.1 → 1.62.0）；2.29 以上需要更新的 API，不可直接升級 -->
        <!-- Spring Shell 不受 Boot 管理；4.0.3 已實測可在 Boot 4.1.1 上執行 -->
        <spring-shell.version>4.0.3</spring-shell.version>
        <opentelemetry-logback-appender.version>2.28.1-alpha</opentelemetry-logback-appender.version>
        <!-- 只有可執行的模組改成 false；-am 時函式庫模組才不會被 spring-boot:run -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 內部模組 -->
            <dependency>
                <groupId>cc.alexlin7</groupId>
                <artifactId>bancho-irc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- FakeIrcServer、RecordingIrcSender 等測試輔助類別 -->
            <dependency>
                <groupId>cc.alexlin7</groupId>
                <artifactId>bancho-irc</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>cc.alexlin7</groupId>
                <artifactId>bancho-match</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.alexlin7</groupId>
                <artifactId>bancho-observability</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 不受 Spring Boot 管理的第三方依賴 -->
            <dependency>
                <groupId>org.springframework.shell</groupId>
                <artifactId>spring-shell-starter</artifactId>
                <version>${spring-shell.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.shell</groupId>
                <artifactId>spring-shell-jline</artifactId>
                <version>${spring-shell.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.shell</groupId>
                <artifactId>spring-shell-starter-test</artifactId>
                <version>${spring-shell.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-logback-appender-1.0</artifactId>
                <version>${opentelemetry-logback-appender.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有子模組共用 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <!-- spring-boot-maven-plugin 只能宣告在可執行的模組：函式庫模組被 repackage 後，其他模組就無法依賴它 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                                <path>
                                    <groupId>org.springframework.boot</groupId>
                                    <artifactId>spring-boot-configuration-processor</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
