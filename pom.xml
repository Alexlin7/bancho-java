<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>cc.alexlin7.bancho</groupId>
    <artifactId>bancho-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>bancho</name>
    <description>osu! Bancho IRC client 與多人房裁判機器人</description>
    <url>https://github.com/Alexlin7/bancho-java</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>Alexlin7</id>
            <name>Alexlin7</name>
            <url>https://github.com/Alexlin7</url>
        </developer>
    </developers>
    <!-- 關掉子模組自動在網址後面加上 artifactId -->
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/Alexlin7/bancho-java.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Alexlin7/bancho-java.git</developerConnection>
        <url>https://github.com/Alexlin7/bancho-java</url>
    </scm>

    <!-- 依賴方向：shell / discord → match → irc；irc-spring 與 observability 只給前端使用 -->
    <modules>
        <module>bancho-irc</module>
        <module>bancho-irc-spring</module>
        <module>bancho-match</module>
        <module>bancho-match-spring</module>
        <module>bancho-observability</module>
        <module>bancho-shell</module>
        <module>bancho-discord</module>
    </modules>

    <properties>
        <!-- 所有模組的版本只寫在這裡；發布的 pom 由 flatten-maven-plugin 換成實際版本 -->
        <revision>0.1.2-SNAPSHOT</revision>
        <java.version>25</java.version>
        <!-- 必須對應 Boot 管理的 OTel API 版本（Boot 4.1.1 → 1.62.0）；2.29 以上需要更新的 API，不可直接升級 -->
        <opentelemetry-logback-appender.version>2.28.1-alpha</opentelemetry-logback-appender.version>
        <!-- Spring Shell 不受 Boot 管理；4.0.3 已實測可在 Boot 4.1.1 上執行 -->
        <spring-shell.version>4.0.3</spring-shell.version>

        <!-- 發布用的 plugin；Boot 不管理這兩個版本 -->
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <!-- 0.12.0 修正了 Maven 3.10.0 被 Central 拒絕的問題；這個 plugin 不支援 Maven 4 -->
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <!-- Boot 也不管理 flatten-maven-plugin -->
        <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>

        <!-- 只有可執行的模組改成 false；-am 時函式庫模組才不會被 spring-boot:run -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
        <!-- 不發布到 Maven Central 的模組改成 true（同時略過 sources、javadoc 與簽章） -->
        <bancho.publish.skip>false</bancho.publish.skip>
        <!-- 以屬性串接而不是寫死在 plugin configuration，命令列的 -Dgpg.skip 等才能覆寫 -->
        <maven.source.skip>${bancho.publish.skip}</maven.source.skip>
        <maven.javadoc.skip>${bancho.publish.skip}</maven.javadoc.skip>
        <gpg.skip>${bancho.publish.skip}</gpg.skip>
        <!-- -Dbancho.central.skip-upload=true：只產生 bundle（target/central-publishing/）不上傳，用來檢查內容 -->
        <bancho.central.skip-upload>false</bancho.central.skip-upload>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 內部模組 -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>bancho-irc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- FakeIrcServer、RecordingIrcSender 等測試輔助類別 -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>bancho-irc</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>bancho-irc-spring</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>bancho-match</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>bancho-match-spring</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>bancho-observability</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 不受 Spring Boot 管理的第三方依賴 -->
            <dependency>
                <groupId>org.springframework.shell</groupId>
                <artifactId>spring-shell-starter</artifactId>
                <version>${spring-shell.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.shell</groupId>
                <artifactId>spring-shell-jline</artifactId>
                <version>${spring-shell.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.shell</groupId>
                <artifactId>spring-shell-starter-test</artifactId>
                <version>${spring-shell.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-logback-appender-1.0</artifactId>
                <version>${opentelemetry-logback-appender.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有子模組共用 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <!-- 檢查 javadoc 格式錯誤，但不要求每個 public 成員都寫註解 -->
                        <doclint>all,-missing</doclint>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- spring-boot-maven-plugin 只能宣告在可執行的模組：函式庫模組被 repackage 後，其他模組就無法依賴它 -->
        <plugins>
            <!-- 把安裝與發布的 pom 中的 ${revision} 換成實際版本，其他內容（含 parent 鏈）維持原樣；
                 不換的話使用者解析不了 ${revision}。Maven 4 原生支援，但 central-publishing 不支援 Maven 4 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                                <path>
                                    <groupId>org.springframework.boot</groupId>
                                    <artifactId>spring-boot-configuration-processor</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 發布到 Maven Central：./mvnw -P release deploy（需要 GPG 金鑰與 settings.xml 的 central token） -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <skipPublishing>${bancho.publish.skip}</skipPublishing>
                            <skipUpload>${bancho.central.skip-upload}</skipUpload>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
